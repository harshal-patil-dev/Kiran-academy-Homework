<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC 
  "-//Hibernate/Hibernate Configuration DTD 3.0//EN" 
  "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<!-- Version 8 MySQL hiberante-cfg.xml example for Hibernate 5 -->
<hibernate-configuration>
  <session-factory>
    <property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
    <!-- property name="connection.driver_class">com.mysql.jdbc.Driver</property -->
    <property name="connection.url">jdbc:mysql://localhost/Mapping_db?createDatabaseIfNotExist=true</property>
    <property name="dialect">org.hibernate.dialect.MySQL8Dialect</property>
    <property name="connection.username">root</property>
    <property name="connection.password">root</property>

    <property name="show_sql">true</property>
    <property name="format_sql">true</property>
    <property name="hbm2ddl.auto">update</property>
    
    <!-- mapping class="com.mcnz.jpa.examples.Player" / -->
    <mapping class ="com.tka.OneToOne.Person"/>
    <mapping class ="com.tka.OneToOne.Passport"/>
    
    <mapping class ="com.tka.OneToMany.Department"/>
    <mapping class ="com.tka.OneToMany.Employee"/>
    
    <mapping class ="com.tka.ManyToOne.DepartmentOne"/>
    <mapping class ="com.tka.ManyToOne.EmployeeMany"/>
    
    <mapping class ="com.tka.ManyToMany.Student"/>
    <mapping class ="com.tka.ManyToMany.Course"/>
    
  </session-factory>
</hibernate-configuration>